{
  "name": "silverware-libraries",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check-build": "node scripts/build.mjs --check",
    "verify": "tsc --noEmit --noUnusedLocals && vitest run && node scripts/build.mjs --check",
    "watch": "node scripts/build.mjs --watch",
    "deploy": "node scripts/deploy.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:ui:open": "playwright test --ui",
    "test:ui:install": "playwright install chromium",
    "playground": "node scripts/playground.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
